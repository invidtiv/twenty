  "logicFunctions": [
    {
      "universalIdentifier": "0a0ad7e3-22aa-46f9-8952-cc56ab043b83",
      "name": "kairos-query-api",
      "description": "Authenticated operational queries for bookings, calendar events, contact resolution, and read-only email access.",
      "timeoutSeconds": 30,
      "httpRouteTriggerSettings": {
        "path": "/kairos/query",
        "httpMethod": "POST",
        "isAuthRequired": true
      },
      "handlerName": "default.config.handler",
      "sourceHandlerPath": "src/logic-functions/kairos-query-api.logic-function.ts",
      "builtHandlerPath": "src/logic-functions/kairos-query-api.logic-function.mjs",
      "builtHandlerChecksum": "2e876dac6bd3c4ddd1e68e418a2f97df"
    },
    {
      "universalIdentifier": "19643ca5-bb55-499c-9820-f19cba74c8cc",
      "name": "on-booking-changed",
      "description": "Recalculates readiness and idempotently creates expected service events.",
      "timeoutSeconds": 30,
      "databaseEventTriggerSettings": {
        "eventName": "booking.*",
        "updatedFields": [
          "source",
          "externalBookingId",
          "guest",
          "property",
          "checkinAt",
          "checkoutAt",
          "arrivalWindowStart",
          "arrivalWindowEnd",
          "timezone",
          "status"
        ]
      },
      "handlerName": "default.config.handler",
      "sourceHandlerPath": "src/logic-functions/on-booking-changed.logic-function.ts",
      "builtHandlerPath": "src/logic-functions/on-booking-changed.logic-function.mjs",
      "builtHandlerChecksum": "e25f26e66130500802c29b8233538e42"
    },
    {
      "universalIdentifier": "1cc711a6-17d3-4edd-8453-86500768f042",
      "name": "kairos-records-api",
      "description": "Authenticated idempotent mutation boundary for Kairos operational records.",
      "timeoutSeconds": 30,
      "httpRouteTriggerSettings": {
        "path": "/kairos/records",
        "httpMethod": "POST",
        "isAuthRequired": true
      },
      "handlerName": "default.config.handler",
      "sourceHandlerPath": "src/logic-functions/kairos-records-api.logic-function.ts",
      "builtHandlerPath": "src/logic-functions/kairos-records-api.logic-function.mjs",
      "builtHandlerChecksum": "78699462248b0ce8b115070a57af3a87"
    },
    {
      "universalIdentifier": "3a8ca6c3-972c-45c6-bfc3-d97f7775690c",
      "name": "on-source-record-changed",
      "description": "Preserves source provenance and requests booking reconciliation without applying source values.",
      "timeoutSeconds": 30,
      "databaseEventTriggerSettings": {
        "eventName": "sourceRecord.*",
        "updatedFields": [
          "booking",
          "parseStatus",
          "error",
          "contentHash"
        ]
      },
      "handlerName": "default.config.handler",
      "sourceHandlerPath": "src/logic-functions/on-source-record-changed.logic-function.ts",
      "builtHandlerPath": "src/logic-functions/on-source-record-changed.logic-function.mjs",
      "builtHandlerChecksum": "59a9a8989212b52d7480adb702f12836"
    }
  ],
