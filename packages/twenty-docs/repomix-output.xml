import { CardTitle } from "/snippets/card-title.mdx"

<CardGroup cols={3}>
  <Card href="/l/zh/developers/extend/apps/getting-started" img="/images/user-guide/halftone/dev-apps.png">
    <CardTitle>应用</CardTitle>
