const execFileAsync = promisify(execFile);

export const getLocalServerVersion = async (
  containerName: string = CONTAINER_NAME,
): Promise<string | null> => {
  try {
    const { stdout } = await execFileAsync(
      'docker',
      [
        'inspect',
        '-f',
        '{{range .Config.Env}}{{println .}}{{end}}',
        containerName,
      ],
