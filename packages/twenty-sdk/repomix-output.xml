    });

    describe('complex-soft-delete-front-component', () => {
      it('should allow soft delete for local record with selection', () => {
        const context = buildMockCommandMenuContextApi({
          numberOfSelectedRecords: 2,
          selectedRecords: [
            {
              id: 'rec-1',
